{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neruvalo",
  "version": "0.1.0",
  "identifier": "org.neruvalo.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist",
    "features": [
      "desktop"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Neruvalo \u00b7 Prototype",
        "width": 1320,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "Self-hosted password and secrets manager prototype",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
